# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-64-char-hex-secret"

# Optional seed overrides (FIND-002 deployment gate — see README-SECURITY.md):
# when NODE_ENV=production the seed REFUSES the dev defaults and requires these.
# SEED_ADMIN_PASSWORD="change-me-before-production"
# SEED_FACULTY_PASSWORD="change-me-before-production"
